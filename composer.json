{
    "name": "celtic34fr/select2vanilla-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle for using the vanilla JavaScript library celtic34fr/select2vanilla as a FormType",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Select2VanillaBundle"
        }
    ],
    "autoload": {
        "psr-4": {
            "Select2VanillaBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Select2VanillaBundle\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/celtic34fr/select2vanilla.git"
        }
    ],
    "require": {
        "php": "^8.1",
        "symfony/framework-bundle": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/form": "^8.0",
        "symfony/options-resolver": "^8.0",
        "celtic34fr/select2vanilla": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6|^10.5|^11.0"
    },
    "scripts": {
        "sync-assets": "php bin/sync-assets.php"
    },
    "suggest": {
        "symfony/asset-mapper": "Pour mapper automatiquement les assets JS/CSS de select2vanilla via Asset Mapper"
    }
}
